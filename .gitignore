build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Jupyter Notebooks
# ==========================================
.ipynb_checkpoints/
*-checkpoint.ipynb

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.*.local
*.secret
*.pem
*.key

# ==========================================
# Machine Learning Models & Heavy Weights (>50MB)
# ==========================================
*.keras
*.h5
*.hdf5
*.tflite
*.pt
*.pth
*.onnx
*.pkl
*.joblib
*.pb
# Uncomment if entire models directory should be ignored:
# models/

# ==========================================
# Project Output & Generated Data
# ==========================================
outputs/*
!outputs/.gitkeep
# Uncomment if raw datasets should not be committed:
# data/*
# !data/.gitkeep

